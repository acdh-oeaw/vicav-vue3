{
	"name": "@acdh-oeaw/vicav-frontend",
	"version": "0.8.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": "24.x",
		"pnpm": "10.x"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "NUXT_PUBLIC_CURRENT_GIT_SHA=$(git describe --tags --always) && run-s generate:api-client build:client",
		"build:client": "nuxt build --dotenv ./.env.local",
		"dev": "NUXT_PUBLIC_CURRENT_GIT_SHA=$(git describe --tags --always) && nuxt dev --dotenv ./.env.local --host 127.0.0.1 --no-fork",
		"format:check": "prettier . --cache --check --ignore-path ./.gitignore --ignore-path ./.prettierignore",
		"format:fix": "pnpm run format:check --write",
		"generate:api-client": "curl -fsSL \"https://raw.githubusercontent.com/acdh-oeaw/vicav-app-api/master/openapi.json\" -o app/assets/openapi.json && swagger-typescript-api generate --path app/assets/openapi.json --clean-output --name index.ts --output app/lib/api-client/",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "pnpm run lint:code:check-no-cache --cache",
		"lint:code:check-no-cache": "eslint .",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "pnpm run lint:styles:check-no-cache --cache",
		"lint:styles:check-no-cache": "stylelint \"./**/*.@(css|vue)\" --ignore-path ./.gitignore --ignore-path ./public/???.css",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"postinstall": "nuxt prepare",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup generate:api-client",
		"setup": "is-ci || simple-git-hooks",
		"start:preview": "nuxt preview --dotenv ./.env.local",
		"start": "node .output/server/index.mjs",
		"start:local": "dotenv -e .env.local -- pnpm run start",
		"test": "dotenv -e .env.local -- node checkenv.mjs && pnpm playwright install && run-p format:check \"lint:*:check-no-cache\" types:check test:unit test:e2e",
		"test:e2e": "dotenv -e .env.local -- playwright test",
		"test:e2e:codegen": "dotenv -e .env.local -- playwright codegen",
		"test:e2e:debug": "dotenv -e .env.local -- playwright test --debug",
		"test:e2e:ui": "dotenv -e .env.local -- playwright test --ui",
		"test:unit": "vitest --run --typecheck --passWithNoTests",
		"types:check": "nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test:unit",
		"heroku-postbuild": "pnpm run build && node heroku-postbuild-cleanup.js"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@citation-js/core": "^0.7.21",
		"@citation-js/plugin-csl": "^0.7.22",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.4",
		"@codemirror/view": "^6.43.3",
		"@fontsource-variable/roboto-flex": "^5.2.8",
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@iconify/vue": "^4.3.0",
		"@jpinsonneau/html-to-image": "^1.11.13",
		"@lezer/highlight": "^1.2.3",
		"@lucide/vue": "^1.21.0",
		"@maplibre/maplibre-gl-leaflet": "^0.1.3",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/context-async-hooks": "^2.8.0",
		"@opentelemetry/core": "^2.8.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.206.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.206.0",
		"@opentelemetry/instrumentation": "^0.205.0",
		"@opentelemetry/instrumentation-runtime-node": "^0.19.2",
		"@opentelemetry/instrumentation-undici": "^0.16.2",
		"@opentelemetry/resources": "^2.8.0",
		"@opentelemetry/sdk-metrics": "^2.8.0",
		"@opentelemetry/sdk-node": "^0.205.0",
		"@opentelemetry/sdk-trace-node": "^2.8.0",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"@pinia/nuxt": "^0.5.5",
		"@tanstack/vue-query": "^5.101.1",
		"@tanstack/vue-table": "8.11.8",
		"@types/pino-http": "^5.8.4",
		"@unovis/ts": "^1.6.5",
		"@unovis/vue": "^1.6.5",
		"@vueuse/core": "^13.9.0",
		"@vueuse/nuxt": "^13.9.0",
		"autoprefixer": "^10.5.2",
		"class-variance-authority": "^0.7.1",
		"codemirror": "^6.0.2",
		"colorjs.io": "^0.5.2",
		"cva": "1.0.0-beta.1",
		"h3-compression": "^0.3.2",
		"is-ci": "^3.0.1",
		"leaflet": "^1.9.4",
		"lightgallery": "^2.9.0",
		"liqe": "^3.8.7",
		"maplibre-gl": "^5.24.0",
		"nanoid": "^5.1.16",
		"nitro-opentelemetry": "^0.10.2",
		"npm-run-all2": "^6.2.6",
		"nuxt": "^4.4.8",
		"nuxt-svgo": "^4.2.6",
		"pinia": "^3.0.4",
		"radix-vue": "^1.9.17",
		"reka-ui": "^2.10.1",
		"swagger-typescript-api": "13.0.28",
		"tailwind-merge": "^2.6.1",
		"transliteration": "^2.6.1",
		"ts-error": "^1.0.6",
		"v3-infinite-loading": "^1.3.2",
		"vee-validate": "^4.15.1",
		"vue": "3.5.13",
		"vue-codemirror6": "1.4.3",
		"vue-material-design-icons": "^5.3.1",
		"vue-router": "^5.1.0",
		"winbox": "^0.2.82",
		"xlsx": "^0.18.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@acdh-oeaw/eslint-config": "^2.0.13",
		"@acdh-oeaw/eslint-config-node": "^2.0.13",
		"@acdh-oeaw/eslint-config-nuxt": "^2.0.19",
		"@acdh-oeaw/eslint-config-playwright": "^2.0.15",
		"@acdh-oeaw/eslint-config-tailwindcss": "^4.1.4",
		"@acdh-oeaw/eslint-config-vue": "^2.0.17",
		"@acdh-oeaw/prettier-config": "^2.0.1",
		"@acdh-oeaw/stylelint-config": "^2.3.2",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@axe-core/playwright": "^4.12.1",
		"@nuxt/devtools": "^3.2.4",
		"@nuxt/eslint": "^1.16.0",
		"@nuxt/test-utils": "^3.23.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/eslint-plugin-query": "^5.101.1",
		"@types/color": "^4.2.1",
		"@types/geojson": "^7946.0.16",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^24.13.3",
		"@types/winbox": "0.2.3",
		"@vitest/coverage-v8": "^4.1.9",
		"@vue/test-utils": "^2.4.11",
		"ci-info": "^3.9.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.6.1",
		"dotenv-cli": "^8.0.0",
		"dotenv-expand": "^12.0.3",
		"eslint": "^9.39.4",
		"eslint-config-flat-gitignore": "^2.3.0",
		"eslint-plugin-check-file": "^3.3.1",
		"h3": "^1.15.11",
		"happy-dom": "20.3.4",
		"lint-staged": "15.2.7",
		"nitropack": "^2.13.4",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"schema-dts": "^1.1.5",
		"simple-git-hooks": "^2.13.1",
		"stylelint": "^16.26.1",
		"tailwindcss": "^4.3.1",
		"tailwindcss-animate": "^1.0.7",
		"type-fest": "^4.41.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0",
		"vitest": "^4.1.9",
		"vue-tsc": "^2.2.12"
	},
	"resolutions": {
		"vue": "3.5.13"
	},
	"pnpm": {
		"patchedDependencies": {
			"winbox@0.2.82": "patches/winbox@0.2.82.patch",
			"@types/winbox@0.2.3": "patches/@types__winbox@0.2.3.patch",
			"liqe": "patches/liqe.patch"
		},
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"@tailwindcss/oxide",
			"esbuild",
			"protobufjs",
			"simple-git-hooks",
			"unrs-resolver",
			"vue-demi"
		]
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"lint-staged": {
		"*.vue": [
			"eslint --cache --fix",
			"stylelint --cache --fix",
			"prettier --cache --write"
		],
		"*.@(js|ts)": [
			"eslint --cache --fix",
			"prettier --cache --write"
		],
		"*.css": [
			"stylelint --cache --fix --ignore-path public/tei.css --ignore-path public/odd.css",
			"prettier --cache --write"
		],
		"*.!(css|js|ts|vue)": "prettier --cache --ignore-unknown --write"
	},
	"prettier": "@acdh-oeaw/prettier-config",
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged"
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}
